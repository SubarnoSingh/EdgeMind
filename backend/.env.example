# EdgeMind backend — environment template. Copy to `.env` (gitignored) and
# fill in REAL values. Never commit this file's real values anywhere.

# --- Qdrant Cloud (required for push/pull/search) ---
QDRANT_URL=
QDRANT_API_KEY=

# --- Cloud collections (defaults shown) ---
QDRANT_DEVICE_MEMORY_COLLECTION=device_memory
QDRANT_CLOUD_KNOWLEDGE_COLLECTION=cloud_knowledge
EMBEDDING_DIMENSION=1024

# --- Cloud LLM provider (OpenAI-compatible chat completions) ---
# If CLOUD_LLM_API_KEY is empty, /answers honestly reports LLM_NOT_CONFIGURED.
CLOUD_LLM_API_KEY=
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_MODEL=
CLOUD_LLM_TIMEOUT_MS=20000

# --- Optional embeddings provider for cloud-side semantic search ---
# Uses the same OpenAI-compatible /embeddings endpoint. If empty, cloud search
# is disabled and reports EMBEDDING_NOT_CONFIGURED (push/pull still work).
CLOUD_EMBEDDING_API_KEY=
CLOUD_EMBEDDING_BASE_URL=https://api.openai.com/v1
CLOUD_EMBEDDING_MODEL=

# --- Server ---
PORT=8080
# Optional guard for the curation endpoint POST /knowledge/ingest. When empty,
# the endpoint is open (development only — do not deploy that way).
ADMIN_API_KEY=

# --- Limits ---
MAX_REQUEST_BYTES=1048576
MAX_QUESTION_CHARS=2000
MAX_ANSWER_CHARS=8000
