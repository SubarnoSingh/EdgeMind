{
  "name": "edgemind-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EdgeMind cloud boundary: Qdrant Cloud access, device knowledge push, curated knowledge pull, cloud question answering. Owns all cloud credentials; the Android app never holds them.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/",
    "verify:config": "tsx src/scripts/verifyConfig.ts"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.13.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
