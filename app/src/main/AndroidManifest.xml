<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required by WorkManager to observe connectivity for the durable sync
         outbox (Phase 6). Offline memory operations never need it; the worker
         is a no-op without an acknowledged remote. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phase 8 security review: backups are disabled. The Room database and
         the qdrant shard contain LOCAL_ONLY and SYNC_REDACTED originals that
         must never leave the device, including through the platform cloud
         backup channel. -->
    <application
        android:name=".EdgeMindApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>